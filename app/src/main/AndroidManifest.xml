<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Lembrar a dose na hora certa é a função do app, não um extra.

      POST_NOTIFICATIONS é pedido em tempo de execução a partir do Android 13.

      USE_EXACT_ALARM cobre o Android 14+: a Google concede-a sem diálogo a apps
      cuja função central é alarme/lembrete — é exatamente este caso, e um
      lembrete de medicação que escorrega meia hora não serve. Em Android 12/13
      a mesma capacidade vem de SCHEDULE_EXACT_ALARM, que o utilizador pode
      revogar; o agendador degrada para alarme inexato nesse caso em vez de
      rebentar.

      RECEIVE_BOOT_COMPLETED volta a armar os alarmes depois de reiniciar o
      telemóvel — sem isso o utilizador ficava sem lembretes até reabrir o app.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="33" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      A web mostra o lembrete em ecrã inteiro (`alertDisplayType: 'fullscreen'`,
      o padrão). No telemóvel isso é a full-screen intent da notificação, que
      abre o ReminderAlertActivity mesmo com o ecrã bloqueado.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!--
      Com o celular em uso a full-screen intent vira uma notificação pequena;
      "Sobrepor a outros apps" deixa o lembrete de remédio abrir grande mesmo assim.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".MemoriaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MemoriaMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MemoriaMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          "Hora do Medicamento!" em ecrã inteiro (o `#notificationModal` com
          `notification-fullscreen`), por cima do ecrã de bloqueio. Tarefa própria
          e fora dos recentes: responder "Tomei" não deve trazer a app atrás.
        -->
        <activity
            android:name=".ReminderAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.memoria.mobile.reminder"
            android:theme="@style/Theme.MemoriaMobile.Reminder" />

        <!-- Fotos da câmara das receitas em resolução total (TakePicture). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Dispara o lembrete e trata os botões "Tomei" / "Adiar". -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Rearma os alarmes depois do arranque e de uma atualização do app. -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
